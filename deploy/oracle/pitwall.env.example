# /etc/pitwall/pitwall.env  (owner root, group pitwall, mode 640). Never commit the real file.
PITWALL_DATA=/opt/pitwall/data
# backend (Oracle: data from collectors), collector (reaches F1, ships to the backend) or standalone.
PITWALL_ROLE=standalone
PLAYWRIGHT_BROWSERS_PATH=/opt/pitwall/.browsers
SCHEDULE_CACHE=/opt/pitwall/data/schedule-cache.json
# Pull the latest code from GitHub before each session (1) or never (0).
AUTO_UPDATE=1
# Push learned/ back to GitHub after sessions (needs a deploy key with write access). Keep 0
# while the Mac also shares, so the two don't both push.
SHARE_LEARNED=0
# Off-server backup with rclone, e.g. r2:pitwall-recordings  (set up with: sudo -u pitwall rclone config)
RCLONE_REMOTE=
# Remove backed-up local copies when free space falls below this percentage.
MIN_FREE_PCT=15
# Phone alerts: a private ntfy.sh topic URL (anyone who knows the name can read it; make it long and random).
NTFY_URL=

# ---- backend only ----
# The relay builds its live state from what collectors send, instead of connecting to F1.
FOLLOW=
# The prediction page reads that relay.
PAGE_URL=
# Where ingest listens: 127.0.0.1 (collector comes in over an SSH tunnel) or this machine's
# Tailscale address (100.x.y.z). Never a public address.
INGEST_HOST=127.0.0.1
INGEST_PORT=8770
INGEST_SECRET_FILE=/etc/pitwall/ingest-secret
# Refuse new data (collector keeps it) when free space is below this many GB.
INGEST_MIN_FREE_GB=2

# ---- collector only ----
# The backend's ingest address as seen from here: http://127.0.0.1:8770 (SSH tunnel) or
# http://<backend Tailscale name or 100.x address>:8770
SHIP_URL=
# A short name for this collector (letters, digits, dashes)
SHIP_ID=
# Kalshi is recorded on the backend; the collector can leave it off.
KALSHI=0
