[Unit]
Description=Pitwall health check (restarts the relay or page when needed)

[Service]
Type=oneshot
User=pitwall
Group=pitwall
WorkingDirectory=/opt/pitwall
EnvironmentFile=/etc/pitwall/pitwall.env
ExecStart=/usr/local/bin/node tools/health.mjs
TimeoutStartSec=90
# It writes data/health.json and data/health.log itself; anything unexpected goes to the journal.
StandardOutput=null
